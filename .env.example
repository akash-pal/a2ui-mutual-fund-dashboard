# One of: anthropic | openai
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the default model id for the selected provider (e.g. to point
# ANTHROPIC_BASE_URL/OPENAI_BASE_URL at a local Ollama server and use one of its
# pulled models instead of the real cloud API).
# ANTHROPIC_MODEL_ID=claude-sonnet-5
# OPENAI_MODEL_ID=gpt-5
